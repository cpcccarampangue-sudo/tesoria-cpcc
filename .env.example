# Copiar este archivo a .env.local y completar con los valores del proyecto Supabase.
# En Supabase Dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key...

# URL pública de la app para el callback del magic link.
# En local: http://localhost:3000
# En producción (Netlify): https://tu-app.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto (pepper) para hashear códigos OTP de /incorporacion.
# Mínimo 16 caracteres aleatorios. Si se filtra, rotarla (invalida los
# OTPs vigentes en ese momento, los usuarios piden uno nuevo).
# Generar con: openssl rand -hex 32
OTP_SECRET=cambia-esto-por-32-chars-aleatorios
