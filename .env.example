# Copiar este archivo a .env.local y completar con los valores del proyecto Supabase.
# En Supabase Dashboard → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...tu-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...tu-service-role-key...

# URL pública de la app para el callback del magic link.
# En local: http://localhost:3000
# En producción (Netlify): https://tu-app.netlify.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto (pepper) para hashear códigos OTP de /incorporacion y /validar.
# Mínimo 16 caracteres aleatorios. Si se filtra, rotarla (invalida los
# OTPs vigentes en ese momento, los usuarios piden uno nuevo).
# Generar con: openssl rand -hex 32
OTP_SECRET=cambia-esto-por-32-chars-aleatorios

# Secreto para HMAC-SHA256 de validaciones_log (qr_token_hmac,
# directiva_actor_hmac). Debe ser INDEPENDIENTE de OTP_SECRET.
# Mínimo 32 caracteres aleatorios. NO rotar sin plan de versionado:
# rotarla rompe la correlación de todos los HMACs históricos del log.
# Generar con: openssl rand -hex 32
AUDIT_HMAC_SECRET=cambia-esto-por-32-chars-aleatorios-independiente

# Envío de correo transaccional vía Gmail SMTP (nodemailer).
# GMAIL_USER: correo de la cuenta Gmail del CdP.
# GMAIL_APP_PASSWORD: "contraseña de aplicación" generada en
#   myaccount.google.com → Seguridad → Contraseñas de aplicaciones.
#   16 chars. Puede venir con o sin espacios.
# GMAIL_FROM_NAME: nombre visible del remitente (opcional).
# GMAIL_REPLY_TO: correo para respuestas si distinto al remitente (opcional).
GMAIL_USER=centropadres.colegiocarampangue@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
GMAIL_FROM_NAME=Centro de Padres Colegio Carampangue
# GMAIL_REPLY_TO=tesoreria@centropadrescarampangue.cl

# URL completa del webhook SumUp (fija, independiente de preview deploys).
# SumUp POST'ea aquí las notificaciones de estado de los checkouts.
# Si no se setea, se construye a partir de NEXT_PUBLIC_SITE_URL + "/api/webhooks/sumup".
# En producción fijar al dominio canónico para evitar que un preview
# deploy reciba webhooks de pagos reales.
SUMUP_WEBHOOK_URL=https://tesoreria.centropadrescarampangue.cl/api/webhooks/sumup
